<mujoco model="MyCobot Pro 450">
  <compiler angle="degree"/>

  <default>
    <geom type="capsule" density="1000"/>
  </default>

  <worldbody>
    <light pos="1 1 2" diffuse="1 1 1"/>
    <geom name="floor" type="plane" size="1 1 0.1" rgba=".8 .8 .8 1"/>

    <!-- Base column. Child body pos = joint origin -->
    <body name="base" pos="0 0 0">
      <geom name="base_col" fromto="0 0 0 0 0 0.27" size="0.04" rgba=".8 .3 .3 1"/>

      <body name="link1" pos="0 0 0.27">
        <geom name="j1" pos="0 0 0.03" size="0.03" type="sphere" rgba=".3 .8 .3 1"/>
        <joint name="joint1" type="hinge" axis="0 0 1" limited="true" range="-162 162"/>

        <body name="link2" pos="0 0 0.06">
          <geom name="upper_arm" fromto="0 0 0 0 0 0.138" size="0.03" rgba=".3 .3 .8 1"/>
          <joint name="joint2" type="hinge" axis="0 1 0" limited="true" range="-125 125"/>

          <body name="link3" pos="0 0 0.138">
            <geom name="forearm" fromto="0 0 0 0 0 0.138" size="0.025" rgba=".8 .8 .3 1"/>
            <joint name="joint3" type="hinge" axis="0 1 0" limited="true" range="-154 154"/>

            <body name="link4" pos="0 0 0.138">
              <geom name="wrist" size="0.02" type="sphere" rgba=".3 .8 .8 1"/>
              <joint name="joint4" type="hinge" axis="1 0 0" limited="true" range="-162 162"/>

              <body name="link5" pos="0 0 0">
                <geom name="end" fromto="0 0 0 0 0 0.1" size="0.012" rgba=".5 .5 .5 1"/>
                <joint name="joint5" type="hinge" axis="0 1 0" limited="true" range="-162 162"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>
